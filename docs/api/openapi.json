            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lng",
            "required": true,
            "in": "query",
            "description": "Längengrad (GeoJSON-Reihenfolge)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lat",
            "required": true,
            "in": "query",
            "description": "Breitengrad",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Kategoriefilter (mehrfach möglich)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "radius",
            "required": false,
            "in": "query",
            "description": "Radius in Metern (max. 5000, Standard: 1000)",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste der Toiletten mit Score und Distanz"

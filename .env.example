# klopilot.ch — Environment-Variablen
# Kopieren als `.env` und Werte anpassen. NIEMALS committen.

# ─── Datenbank ─────────────────────────────────────────────────────────────
# WICHTIG: Schema muss "public" bleiben — PostGIS-Types sind dort registriert.
# Niemals `prisma db push` verwenden — zerstört die geom-Spalte (§7 in migration.sql).
# Stattdessen: pnpm --filter api db:migrate  (dev)
#              pnpm --filter api db:deploy    (CI/prod)
DATABASE_URL="postgresql://klopilot:klopilot_dev@localhost:5444/klopilot?schema=public"

# Verhindert Advisory-Lock-Deadlocks in CI/Docker-Compose-Umgebungen
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK="1"

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6389"

# ─── Object Storage (MinIO lokal / S3 prod) ────────────────────────────────
S3_ENDPOINT="http://localhost:9010"
S3_REGION="us-east-1"
S3_BUCKET="klopilot-media"
S3_ACCESS_KEY="klopilot"
S3_SECRET_KEY="klopilot_dev_min"
S3_PUBLIC_URL="http://localhost:9010/klopilot-media"

# ─── Suche ─────────────────────────────────────────────────────────────────
MEILI_HOST="http://localhost:7710"
MEILI_KEY="klopilot_dev_meili"

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET="bitte-mit-openssl-rand-base64-32-ersetzen"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="bitte-mit-openssl-rand-base64-32-ersetzen"

OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_APPLE_CLIENT_ID=""
OAUTH_APPLE_TEAM_ID=""
OAUTH_APPLE_KEY_ID=""
OAUTH_APPLE_PRIVATE_KEY=""

# ─── Mail (Magic Link) ─────────────────────────────────────────────────────
MAIL_HOST="localhost"
MAIL_PORT="1035"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="noreply@klopilot.ch"

# ─── Karten ────────────────────────────────────────────────────────────────
MAPTILER_KEY=""
NEXT_PUBLIC_MAPTILER_KEY=""
NEXT_PUBLIC_DEFAULT_LAT="46.9481"
NEXT_PUBLIC_DEFAULT_LNG="7.4474"
NEXT_PUBLIC_DEFAULT_ZOOM="13"

# ─── Moderation ────────────────────────────────────────────────────────────
MODERATION_NSFW_ENDPOINT=""
HCAPTCHA_SITEKEY=""
HCAPTCHA_SECRET=""

# ─── Übersetzung ───────────────────────────────────────────────────────────
DEEPL_API_KEY=""

# ─── Observability ─────────────────────────────────────────────────────────
SENTRY_DSN=""
PLAUSIBLE_DOMAIN="klopilot.ch"

# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT="3001"
WEB_PORT="3000"
PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"

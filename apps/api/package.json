{
  "name": "@klopilot/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build && pnpm build:scripts",
    "build:scripts": "esbuild prisma/seed-osm.ts prisma/reindex-meili.ts prisma/prune-osm-excluded.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist/scripts --external:@prisma/client --external:meilisearch",
    "dev": "node_modules/.bin/nest start --watch",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "if [ -f ../../.env ]; then dotenv-cli -e ../../.env -- vitest run; else vitest run; fi",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts",
    "db:seed-osm": "dotenv -e ../../.env -- ts-node prisma/seed-osm.ts",
    "db:reindex": "dotenv -e ../../.env -- ts-node prisma/reindex-meili.ts",
    "db:prune-osm": "dotenv -e ../../.env -- ts-node prisma/prune-osm-excluded.ts",
    "db:reset": "prisma migrate reset --force && dotenv -e ../../.env -- ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@fastify/cookie": "^8.3.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.0",
    "expo-server-sdk": "^6.1.0",
    "ioredis": "^5.10.1",
    "meilisearch": "^0.58.0",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.0",
    "@types/node": "^20.17.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "fastify": "4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.0"
  }
}

# klopilot.ch — PRODUKTIONS-Umgebungsvariablen
# Diese Datei committen (keine Secrets!).
# Kopieren als /opt/klopilot/.env.prod auf dem Server und Werte ersetzen.
# NIEMALS die befüllte .env.prod committen oder in Logs ausgeben.

# ─── Datenbank ──────────────────────────────────────────────────────────────
# PostGIS auf localhost (Docker-intern); schema=public NICHT ändern.
DATABASE_URL="postgresql://klopilot:CHANGE_ME@postgres:5432/klopilot?schema=public"
POSTGRES_DB="klopilot"
POSTGRES_USER="klopilot"
POSTGRES_PASSWORD="CHANGE_ME"          # openssl rand -base64 32
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK="1"

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL="redis://:CHANGE_ME@redis:6379"
REDIS_PASSWORD="CHANGE_ME"             # openssl rand -base64 24

# ─── Object Storage (MinIO / S3) ───────────────────────────────────────────
S3_ENDPOINT="http://minio:9000"        # intern; öffentlich via minio-api.klopilot.ch
S3_REGION="eu-central-1"
S3_BUCKET="klopilot-media"
S3_ACCESS_KEY="CHANGE_ME"             # min. 3 Zeichen
S3_SECRET_KEY="CHANGE_ME"             # openssl rand -base64 32, min. 8 Zeichen
# Öffentliche URL für Foto-Thumbnails (von der App genutzt)
S3_PUBLIC_URL="https://minio-api.klopilot.ch/klopilot-media"

# ─── Suche ──────────────────────────────────────────────────────────────────
MEILI_HOST="http://meilisearch:7700"
MEILI_KEY="CHANGE_ME"                  # openssl rand -base64 32

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET="CHANGE_ME"                 # openssl rand -base64 64
JWT_EXPIRES_IN="7d"
SESSION_SECRET="CHANGE_ME"            # openssl rand -base64 32

# OAuth (optional, leer lassen wenn nicht benötigt)
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_APPLE_CLIENT_ID=""
OAUTH_APPLE_TEAM_ID=""
OAUTH_APPLE_KEY_ID=""
OAUTH_APPLE_PRIVATE_KEY=""

# ─── Mail (Magic Link) ──────────────────────────────────────────────────────
# Infomaniak SMTP oder Mailgun etc.
MAIL_HOST="mail.infomaniak.com"
MAIL_PORT="587"
MAIL_USER="noreply@klopilot.ch"
MAIL_PASS="CHANGE_ME"
MAIL_FROM="klopilot.ch <noreply@klopilot.ch>"

# ─── Karten ─────────────────────────────────────────────────────────────────
MAPTILER_KEY="CHANGE_ME"              # https://cloud.maptiler.com → API Keys
NEXT_PUBLIC_MAPTILER_KEY="CHANGE_ME"  # gleicher Wert, Browser-sicher
NEXT_PUBLIC_DEFAULT_LAT="46.9481"     # Bern
NEXT_PUBLIC_DEFAULT_LNG="7.4474"
NEXT_PUBLIC_DEFAULT_ZOOM="13"

# ─── API-URL (Next.js → NestJS intern) ──────────────────────────────────────
NEXT_PUBLIC_API_URL="https://api.klopilot.ch"
PUBLIC_API_URL="https://api.klopilot.ch"

# ─── Moderation ─────────────────────────────────────────────────────────────
MODERATION_NSFW_ENDPOINT=""           # optional: eigener NSFW-Classifier
HCAPTCHA_SITEKEY=""
HCAPTCHA_SECRET=""

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=""                          # https://sentry.io → Projekt erstellen
PLAUSIBLE_DOMAIN="klopilot.ch"

# ─── GHCR-Login (für deploy.sh) ─────────────────────────────────────────────
GHCR_TOKEN="CHANGE_ME"               # GitHub PAT mit packages:read
GHCR_USER="4cpa"

# ─── Docker-Image-Koordinaten ───────────────────────────────────────────────
REGISTRY="ghcr.io/4cpa"
TAG="latest"

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"
